<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:layout_margin="4dp"
    app:cardBackgroundColor="#151B22"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeColor="#26313D"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp">

            <ImageView
                android:id="@+id/channelLogo"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:src="@android:drawable/ic_media_play"
                android:scaleType="fitCenter"
                android:background="#202A35"
                android:padding="10dp" />

            <TextView
                android:id="@+id/channelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Channel Name"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/channelCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sports"
                android:textColor="#8FA0B0"
                android:textSize="11sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/liveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● LIVE"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="#D32F2F" />

        <TextView
            android:id="@+id/favoriteButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="♡"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:gravity="center"
            android:layout_gravity="top|end"
            android:clickable="true"
            android:focusable="true"
            android:background="@android:color/transparent" />

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="#26313D" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
